-    background: linear-gradient(180deg, rgba(183, 67, 255, 0) 0%, rgba(69, 22, 187, .62) 42%, var(--bg) 64%)
+    background: linear-gradient(180deg, rgba(183, 67, 255, 0) 0%, var(--pan-b-mid) 42%, var(--bg) 64%)
 }
 
 .pan-b-new {
-    background: linear-gradient(180deg, rgba(69, 22, 187, .62) 0%, 42%, var(--bg) 64%)
+    background: linear-gradient(180deg, var(--pan-b-mid) 0%, 42%, var(--bg) 64%)
 }
 
