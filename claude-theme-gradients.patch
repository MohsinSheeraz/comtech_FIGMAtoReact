@@ -749,7 +769,7 @@ img {
     flex-direction: column;
     align-items: center;
     gap: 20px;
-    background: linear-gradient(180deg, var(--bg) 0%, #0a0620 50%, #170a45 100%);
+    background: linear-gradient(180deg, var(--bg) 0%, var(--ctapanel-mid) 50%, var(--ctapanel-end) 100%);
 }
 
 /* faint dot grid, strongest at the bottom */
