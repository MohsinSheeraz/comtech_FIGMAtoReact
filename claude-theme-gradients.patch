-    --g: linear-gradient(180deg, #5724d8, #7950e2)
+    --g: linear-gradient(180deg, #5724d8, #7950e2);
+    /* long-div purple bands: dark theme */
+    --band-long: linear-gradient(180deg, var(--bg) 8.06%, rgba(69, 22, 187, .42) 43.03%, var(--bg) 80.62%);
+    --band-long-alt: linear-gradient(180deg, var(--bg) 0%, rgba(69, 22, 187, .42) 38%, rgba(69, 22, 187, .55) 62%, var(--bg) 100%);
+    --band-long-top: linear-gradient(180deg, transparent 8.06%, rgba(69, 22, 187, .42) 43.03%, var(--bg) 80.62%);
+    --band-fade: linear-gradient(179.11deg, rgb(var(--bg-rgb) / 0) 10.61%, rgba(69, 22, 187, .36) 53.31%, rgb(var(--bg-rgb) / 0) 99.23%);
+    --band-section: linear-gradient(0deg, var(--bg) 8%, rgba(69, 22, 187, .45) 43%, var(--bg) 81%);
+    --pan-end: #090909;
+    --pan-b-mid: rgba(69, 22, 187, .62);
+    --ctapanel-mid: #0a0620;
+    --ctapanel-end: #170a45
 }
 
 :root[data-theme="light"] {
@@ -50,7 +60,17 @@
     --glow-b: #d3defa;
     --cta-a: #e2d8ff;
     --cta-b: #f1eef9;
-    --g: linear-gradient(180deg, #5724d8, #7950e2)
+    --g: linear-gradient(180deg, #5724d8, #7950e2);
+    /* long-div purple bands: light theme (soft violet wash instead of deep purple) */
+    --band-long: linear-gradient(180deg, var(--bg) 8.06%, rgba(121, 80, 226, .20) 43.03%, var(--bg) 80.62%);
+    --band-long-alt: linear-gradient(180deg, var(--bg) 0%, rgba(121, 80, 226, .18) 38%, rgba(121, 80, 226, .24) 62%, var(--bg) 100%);
+    --band-long-top: linear-gradient(180deg, transparent 8.06%, rgba(121, 80, 226, .20) 43.03%, var(--bg) 80.62%);
+    --band-fade: linear-gradient(179.11deg, rgb(var(--bg-rgb) / 0) 10.61%, rgba(121, 80, 226, .16) 53.31%, rgb(var(--bg-rgb) / 0) 99.23%);
+    --band-section: linear-gradient(0deg, var(--bg) 8%, rgba(121, 80, 226, .20) 43%, var(--bg) 81%);
+    --pan-end: #f6f5fb;
+    --pan-b-mid: rgba(121, 80, 226, .24);
+    --ctapanel-mid: #ebe6fb;
+    --ctapanel-end: #ddd2fb
 }
 
