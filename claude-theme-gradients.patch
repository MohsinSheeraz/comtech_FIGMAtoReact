diff --git a/app/globals.css b/app/globals.css
index 2c53aad..e838220 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -25,7 +25,17 @@
     --glow-b: #193479;
     --cta-a: #1F0C51;
